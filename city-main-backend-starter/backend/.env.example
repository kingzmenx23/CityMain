# Development only. Copy to .env and change the secret.
CITYMAIN_DEBUG=True
CITYMAIN_SECRET_KEY=replace-me-with-a-unique-long-secret
CITYMAIN_ALLOWED_HOSTS=localhost,127.0.0.1

# Local development starts with SQLite. When PostgreSQL is ready, set to True.
CITYMAIN_USE_POSTGRES=False
CITYMAIN_DB_NAME=citymain
CITYMAIN_DB_USER=citymain
CITYMAIN_DB_PASSWORD=
CITYMAIN_DB_HOST=localhost
CITYMAIN_DB_PORT=5432
